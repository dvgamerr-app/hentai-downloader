{
  "name": "hentai-downloader",
  "title": "Hentai Downloader",
  "version": "3.1.0",
  "packageManager": "bun@1.3.14",
  "description": "Manga Hentai in e-hentai.org and exhentai.org downloader.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvgamerr-app/hentai-downloader.git"
  },
  "keywords": [
    "exhentai",
    "e-hentai",
    "hentai",
    "downloader",
    "manga",
    "dark",
    "doujin"
  ],
  "bugs": {
    "url": "https://github.com/dvgamerr-app/hentai-downloader/issues"
  },
  "homepage": "https://github.com/dvgamerr-app/hentai-downloader#readme",
  "author": {
    "name": "Kananek Thongkam",
    "email": "info.dvgamer@gmail.com"
  },
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "bun run build && electron-builder --mac",
    "build:linux": "bun run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "dayjs": "^1.11.23",
    "electron-log": "^5.4.4",
    "electron-settings": "^5.0.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "3.0.0",
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-routing": "^2.13.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.2"
  }
}
